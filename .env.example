# Gavel environment overrides — copy to .env and adjust
# Used by docker-compose.yml

# MySQL root password (CHANGE THIS in any non-local environment)
MYSQL_ROOT_PASSWORD=123456

# Spring datasource (the app reads these)
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/gavel?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=123456

# CORS whitelist (comma-separated origins)
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080
